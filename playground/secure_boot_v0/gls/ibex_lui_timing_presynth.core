CAPI=2:
# Same as ibex_lui_timing_gls.core but against the PRE-PLACE-AND-ROUTE
# synthesis-stage netlist (06-yosys-synthesis/ibex_top.nl.v from the run
# that produced the currently-exported pd/macros/ibex_top/ibex_top.nl.v)
# instead of the final post-PnR netlist. Purpose: bisect whether the LUI
# defect already exists right out of logic synthesis, or gets introduced
# later in place-and-route/CTS/ECO.

name: xinting:playground:ibex_lui_timing_presynth:0.1
description: LUI-then-store test against ibex_top's pre-PnR synthesis-stage netlist

filesets:
  gate_netlist:
    files:
      - ../rtl/gf180mcu_fd_sc_mcu7t5v0__async_dff_simpatch.v
      - ../pd/pdk/gf180mcu/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/verilog/primitives.v
      - ../pd/pdk/gf180mcu/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/verilog/gf180mcu_fd_sc_mcu7t5v0.v
      - ../pd/blocks/ibex_top/runs/RUN_2026-06-29_19-19-49/06-yosys-synthesis/ibex_top.nl.v
    file_type: verilogSource

  tb_sv:
    files:
      - ibex_lui_timing_gls_tb.sv
    file_type: systemVerilogSource

parameters:
  gls_ibex_imem_hex:
    datatype: str
    paramtype: plusarg

targets:
  sim_gls:
    default_tool: verilator
    filesets: [gate_netlist, tb_sv]
    parameters: [gls_ibex_imem_hex]
    toplevel: ibex_lui_timing_gls_tb
    tools:
      verilator:
        verilator_options:
          - "--binary"
          - "--trace-fst"
          - "--bbox-unsup"
          - "--timing"
          - "-Wno-fatal"
          - "-Wno-PINMISSING"
          - "-Wno-UNOPTTHREADS"
          - "-Wno-WIDTH"
          - "-Wno-CASEINCOMPLETE"
          - "-Wno-UNUSED"
          - "-Wno-UNDRIVEN"
          - "-Wno-MULTIDRIVEN"
          - "-Wno-IMPLICIT"
          - "-Wno-SPECIFYIGN"
