plugin -i /foss/tools/bin/eqy_combine.so
read_rtlil ibex_top_prepost_pnr/gold.il
uniquify
hierarchy
design -stash gold
read_rtlil ibex_top_prepost_pnr/gate_recoded.il
uniquify
hierarchy
design -stash gate
eqy_combine -gold_ids ibex_top_prepost_pnr/gold.ids -gate_ids ibex_top_prepost_pnr/gate_recoded.ids
write_rtlil ibex_top_prepost_pnr/combined.il
