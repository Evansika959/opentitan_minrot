CAPI=2:
# Gate-level simulation (GLS) of the taped-out top_pd netlist.
#
# This answers the question top_pd.core (lint-only, blackbox stubs) and
# run_v1.bash/run_standard.bash/run_macro.bash (RTL / macro-level sim of
# `top`/`top_macro`, never the netlist) both leave open: does the actual
# post-synthesis/post-PnR gate netlist that would get taped out still boot
# the same test_sw image and produce the same UART trace?
#
# Stitches together:
#   - pd/macros/top_pd/top_pd.nl.v                 (top-level PD netlist)
#   - pd/macros/{ibex_top,uart,xbar_tlul_2to4,tlul_sram_if_macro}/*.nl.v
#                                                   (the 4 hardened sub-block netlists)
#   - the PDK gf180mcu_fd_sc_mcu7t5v0 standard-cell behavioral models
#   - the existing gf180mcu_ocd_ip_sram SRAM sim model (already used by the
#     macro-level flow, reused here unmodified)
#   - a new backdoor SRAM loader (gls_sram_preload.sv) standing in for the
#     boot-loader path this project doesn't have yet (see that file's header)
#   - a new pin-level testbench (top_pd_gls_tb.sv / main_gls.cpp)
#
# Does NOT modify top_pd.core, secure_boot_v0.core, or anything under rtl/ --
# this is an additional, independent target.

name: xinting:playground:secure_boot_v0_gls:0.1
description: Gate-level simulation of the taped-out top_pd netlist (Ibex + TL-UL SRAM + UART, all as hardened macros), Verilator

filesets:
  gate_netlists:
    files:
      - ../pd/pdk/gf180mcu/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/verilog/primitives.v
      - ../pd/pdk/gf180mcu/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/verilog/gf180mcu_fd_sc_mcu7t5v0.v
      - ../rtl/gf180mcu_ocd_ip_sram__sram256x8m8wm1_simpatch.v
      - ../pd/macros/ibex_top/ibex_top.nl.v
      - ../pd/macros/uart/uart.nl.v
      - ../pd/macros/xbar_tlul_2to4/xbar_tlul_2to4.nl.v
      - ../pd/macros/tlul_sram_if_macro/tlul_sram_if_macro.nl.v
      - ../pd/macros/top_pd/top_pd.nl.v
    file_type: verilogSource

  tb_sv:
    files:
      - gls_sram_preload.sv
      - top_pd_gls_tb.sv
    file_type: systemVerilogSource

  tb_cpp:
    files:
      - main_gls.cpp
    file_type: cppSource

parameters:
  gls_imem_hex:
    datatype: str
    paramtype: plusarg
  gls_dmem_hex:
    datatype: str
    paramtype: plusarg

targets:
  sim_gls:
    default_tool: verilator
    filesets: [gate_netlists, tb_sv, tb_cpp]
    parameters: [gls_imem_hex, gls_dmem_hex]
    toplevel: top_pd_gls_tb
    tools:
      verilator:
        verilator_options:
          - "--trace-fst"
          - "--bbox-unsup"
          - "--timing"
          - "-Wno-fatal"
          - "-Wno-PINMISSING"
          - "-Wno-UNOPTTHREADS"
          - "-Wno-WIDTH"
          - "-Wno-CASEINCOMPLETE"
          - "-Wno-UNUSED"
          - "-Wno-UNDRIVEN"
          - "-Wno-MULTIDRIVEN"
          - "-Wno-IMPLICIT"
          - "-Wno-SPECIFYIGN"
