CAPI=2:
# LUI-immediate diagnostic (top_pd_puf_lui_test_boot.S) against the
# final stage of top_pd_puf's netlist. See
# top_pd_puf_lui_test_tb.sv's header for what this isolates.

name: xinting:playground:top_pd_puf_lui_test_final:0.1
description: LUI test against top_pd_puf final netlist stage

filesets:
  gate_netlists:
    files:
      - ../rtl/gf180mcu_fd_sc_mcu7t5v0__async_dff_simpatch.v
      - ../pd/pdk/gf180mcu/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/verilog/primitives.v
      - ../pd/pdk/gf180mcu/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/verilog/gf180mcu_fd_sc_mcu7t5v0.v
      - /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_ip_sram/verilog/gf180mcu_fd_ip_sram__sram64x8m8wm1.v
      - ../rtl/gf180mcu_ocd_ip_sram__sram256x8m8wm1_simpatch.v
      - ../pd/macros/tlul_sram_if_macro/tlul_sram_if_macro.nl.v
      - ../pd/macros/tlul_sram_if_macro_ocd_21bank/tlul_sram_if_macro_ocd_21bank.nl.v
      - ../pd/macros/top_pd_puf/top_pd_puf.nl.v
    file_type: verilogSource

  tb_sv:
    files:
      - top_pd_puf_lui_test_tb.sv
    file_type: systemVerilogSource

parameters:
  gls_imem_hexdir:
    datatype: str
    paramtype: plusarg

targets:
  sim_gls:
    default_tool: verilator
    filesets: [gate_netlists, tb_sv]
    parameters: [gls_imem_hexdir]
    toplevel: top_pd_puf_lui_test_tb
    tools:
      verilator:
        verilator_options:
          - "--binary"
          - "--trace-fst"
          - "--bbox-unsup"
          - "--timing"
          - "-Wno-fatal"
          - "-Wno-PINMISSING"
          - "-Wno-UNOPTTHREADS"
          - "-Wno-WIDTH"
          - "-Wno-CASEINCOMPLETE"
          - "-Wno-UNUSED"
          - "-Wno-UNDRIVEN"
          - "-Wno-MULTIDRIVEN"
          - "-Wno-IMPLICIT"
          - "-Wno-SPECIFYIGN"
