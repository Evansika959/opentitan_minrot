CAPI=2:
# Resolves the xbar_tlul_2to4 synthesis closure via FuseSoC (including the prim
# wrappers generated by primgen) so harden_block.sh can harvest an ordered file
# list to feed LibreLane, which reads the raw SystemVerilog via USE_SLANG.
# Setup/lint only — never built or run from here.
name: xinting:pd:xbar_tlul_2to4:0.1
description: xbar_tlul_2to4 synthesis closure for the LibreLane flow (FuseSoC setup only)

filesets:
  rtl:
    files:
      - ../../../rtl/autogen/rtl/autogen/tl_tlul_2to4_pkg.sv
      - ../../../rtl/autogen/rtl/autogen/xbar_tlul_2to4.sv
    file_type: systemVerilogSource
    depend:
      - lowrisc:tlul:socket_1n:0.1
      - lowrisc:tlul:socket_m1:0.1
      - lowrisc:tlul:common:0.1
      - lowrisc:prim_generic:all

targets:
  lint:
    default_tool: verilator
    filesets: [rtl]
    toplevel: xbar_tlul_2to4
    tools:
      verilator:
        mode: lint-only
